<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qixidi.business.mapper.privateUser.PrivateUserMapper">
    <!-- 会话对方昵称/头像/职业由 Service 层按 target_uid 调用户域接口组装（SQL 不跨用户域连表） -->
    <select id="selectListXml" resultType="com.qixidi.business.domain.vo.privateUser.PrivateUserVo">
        SELECT pu.target_uid,
               pu.create_time,
               pu.update_time,
               pu.last_news
        FROM b_private_user AS pu
        where pu.uid = #{bo.uid}
        <!-- update_time 即最新消息时间（发消息时 updatePrivateNews 双向刷新），其次按会话创建时间 -->
        ORDER BY pu.update_time DESC, pu.create_time DESC
    </select>
</mapper>
