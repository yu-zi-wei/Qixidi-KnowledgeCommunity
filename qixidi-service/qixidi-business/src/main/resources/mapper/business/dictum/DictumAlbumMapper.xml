<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qixidi.business.mapper.dictum.DictumAlbumMapper">
    <resultMap type="com.qixidi.business.domain.entity.dictum.DictumAlbum" id="DictumAlbumResult">
        <result property="id" column="id"/>
        <result property="uid" column="uid"/>
        <result property="name" column="name"/>
        <result property="cover" column="cover"/>
        <result property="briefIntroduction" column="brief_introduction"/>
        <result property="albumState" column="album_state"/>
        <result property="state" column="state"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <!-- aliveUids=存活作者集合（Service 查用户域 state=0 传入，等价原 join um.state=0 过滤）；
         作者昵称/头像/职业/地域/角色由 Service 层按 uid 组装 -->
    <select id="selectVoPageXml" resultType="com.qixidi.business.domain.vo.dictum.DictumAlbumVo">
        select da.id,
        da.uid,
        da.name,
        da.cover,
        da.brief_introduction,
        da.album_state,
        da.create_time,
        da.update_time
        from b_dictum_album as da
        <where>
            da.state=0
            and da.uid in
            <foreach collection="aliveUids" item="aliveItem" open="(" separator="," close=")">#{aliveItem}</foreach>
            <if test="bo.albumState !=null and bo.albumState!=''">
                and da.album_state=#{bo.albumState}
            </if>
            <if test="bo.uid !=null and bo.uid!=''">
                and da.uid=#{bo.uid}
            </if>
            order by da.id desc
        </where>
    </select>

    <select id="selectAlbumCountByUserIds" resultType="com.qixidi.business.domain.vo.CountUserWebsiteVo">
        SELECT uid AS uuid, COUNT(*) AS albumCount
        FROM b_dictum_album
        WHERE uid IN
        <foreach collection="uuids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        AND state = 0
        GROUP BY uid
    </select>
</mapper>
