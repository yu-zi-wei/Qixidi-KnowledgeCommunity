<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qixidi.business.mapper.comment.ArticleCommentMapper">

    <!-- 后台列表查询：评论人/被回复人昵称头像由 Service 层按 comment_uid/target_uid 调用户域接口组装（SQL 不跨用户域连表）；
         所在文章标题由 Service 层按 article_id 批量查文章域组装 -->
    <sql id="ArticleCommentVo">
        select ac.id, ac.article_id, ac.uid, ac.parent_id, ac.comment_grade, ac.target_id, ac.target_uid,
               ac.comment_uid, ac.content, ac.type, ac.state, ac.create_time, ac.update_time
        from b_article_comment as ac
    </sql>

    <select id="selectCommentIndex" resultType="com.qixidi.business.domain.vo.comment.ArticleCommentVo">
        <include refid="ArticleCommentVo"/>
        ${ew.getCustomSqlSegment}
    </select>

    <select id="selectCommentCountByUserIds" resultType="com.qixidi.business.domain.vo.CountUserWebsiteVo">
        SELECT comment_uid AS uuid, COUNT(*) AS commentCount
        FROM b_article_comment
        WHERE comment_uid IN
        <foreach collection="uuids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        AND state = 0
        GROUP BY comment_uid
    </select>

    <!-- 按作者统计其文章的有效评论数原 join 文章表的查询已下线：UserCountQueryHelper 两步单表 + 内存归并 -->

    <select id="selectCommentCountByArticleIds" resultType="com.qixidi.business.domain.vo.article.ArticleCountVo">
        SELECT article_id AS articleId, COUNT(*) AS count
        FROM b_article_comment
        WHERE article_id IN
        <foreach collection="articleIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        AND state = 0
        GROUP BY article_id
    </select>
</mapper>
